# Groq LLM API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL Database Configuration (pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/review_agent
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/review_agent

# Redis & Queue Worker Configuration
REDIS_URL=redis://localhost:6379/0

# GitHub App Authentication & Webhook
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY_PATH=./secrets/github-private-key.pem
# Alternatively, inline PEM key:
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
GITHUB_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# Service & API Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
ENABLE_VERIFIER=true
ENABLE_REPRODUCTION=true
